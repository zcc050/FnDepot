#!/bin/bash
# Service control. Exit 0 = ok, status exits 3 when stopped.
source "$(dirname "$0")/common"

start_app() {
    export MAGPIE_ADDR="${MAGPIE_ADDR:-127.0.0.1:3425}"
    export MAGPIE_WEB_KEY="$(ensure_web_key)"
    start_bg "${SERVER_DIR}/magpie" web --addr "0.0.0.0:${launcher_port:-3430}" --no-open
}

case "$1" in
    start)   start_app ;;
    stop)    stop_bg ;;
    restart) stop_bg; sleep 1; start_app ;;
    status)  is_running && exit 0 || exit 3 ;;
    *)       echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
