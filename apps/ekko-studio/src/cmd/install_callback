#!/bin/bash
# Runs after files are copied, before the app is started.
source "$(dirname "$0")/common"

chmod +x "${SERVER_DIR}/node/bin/"* "${SERVER_DIR}/ekko/bin/"*.mjs 2>/dev/null
chmod 755 "${SERVER_DIR}/ekko/node_modules/node-pty/prebuilds/linux-x64/spawn-helper" 2>/dev/null
install_log "安装完成: ${TRIM_APPDEST}"
echo "安装完成" >"${TRIM_TEMP_LOGFILE}"
exit 0
