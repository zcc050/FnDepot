#!/bin/bash
# Shared helpers for the fpk lifecycle scripts.
# fnOS exports these when calling cmd/*:
#   TRIM_APPDEST  installed app dir       (/vol1/@appstore/<appname>)
#   TRIM_PKGVAR   persistent data dir     (/vol1/@appdata/<appname>)
#   TRIM_PKGHOME  per-app home dir        (/vol1/@apphome/<appname>)
#   TRIM_APPDIR    fpk root while installing/uninstalling
#   TRIM_TEMP_LOGFILE  file whose content the installer shows on failure
# Wizard fields are exported under their field name (e.g. $port).
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH}"

APPNAME="t3code"
# 桌面入口是 type: url + 独立端口，飞牛不带任何路径前缀，端口必须与监听一致
WEB_PORT="${launcher_port:-3773}"
SERVER_DIR="${TRIM_APPDEST}/server"
LOG_DIR="${TRIM_PKGVAR}/logs"
LOG_FILE="${LOG_DIR}/${APPNAME}.log"
PID_FILE="${TRIM_PKGVAR}/${APPNAME}.pid"
export HOME="${TRIM_PKGHOME}"
export XDG_CONFIG_HOME="${TRIM_PKGHOME}/.config"
export XDG_DATA_HOME="${TRIM_PKGHOME}/.local/share"
export XDG_CACHE_HOME="${TRIM_PKGHOME}/.cache"

mkdir -p "${LOG_DIR}" "${TRIM_PKGHOME}" "${XDG_CONFIG_HOME}" "${XDG_DATA_HOME}" "${XDG_CACHE_HOME}"

log_msg() { echo "$(date '+%F %T') - $*" >>"${LOG_FILE}"; }
# install_log goes to stderr so it lands in the installer's log view.
install_log() { echo "$(date '+%F %T') $*" >&2; }

is_running() {
    [ -s "${PID_FILE}" ] || return 1
    kill -0 "$(cat "${PID_FILE}")" 2>/dev/null || { rm -f "${PID_FILE}"; return 1; }
}

# start_bg <command...>: start detached, return 0 as soon as it is alive.
start_bg() {
    if is_running; then log_msg "already running (pid $(cat "${PID_FILE}"))"; return 0; fi
    log_msg "start: $*"
    ( cd "${SERVER_DIR}" && exec "$@" >>"${LOG_FILE}" 2>&1 ) &
    echo $! >"${PID_FILE}"
    sleep 2
    is_running && { log_msg "started (pid $(cat "${PID_FILE}"))"; return 0; }
    log_msg "exited right after start, see ${LOG_FILE}"
    rm -f "${PID_FILE}"
    return 1
}

stop_bg() {
    is_running || { log_msg "not running"; return 0; }
    local pid; pid=$(cat "${PID_FILE}")
    log_msg "stop (pid ${pid})"
    kill -TERM "${pid}" 2>/dev/null
    for _ in $(seq 1 15); do kill -0 "${pid}" 2>/dev/null || break; sleep 1; done
    kill -0 "${pid}" 2>/dev/null && kill -KILL "${pid}" 2>/dev/null
    rm -f "${PID_FILE}"
    return 0
}

# t3 prints "Pairing URL: http://host:port/pair#token=XXX" once it is ready.
wait_pair_token() {
    local i tok
    for i in $(seq 1 60); do
        tok=$(grep -o 'Pairing URL: [^ ]*#token=[A-Za-z0-9]*' "${LOG_FILE}" 2>/dev/null | tail -1 | sed 's/.*#token=//')
        [ -n "${tok}" ] && { printf '%s' "${tok}"; return 0; }
        sleep 1
    done
    log_msg "no pairing token after 60s (see ${LOG_FILE})"
    return 1
}

# 桌面入口需要长期有效的配对码。
# 启动日志里那个 `Token:` 是一次性/短时效的（pair 默认 5 分钟），用户过一会儿再点小窗
# 就只剩「Invalid pairing token」。所以单独 mint 一个长期 token 写进入口。
mint_pairing_token() {
    local ttl="${T3CODE_ENTRY_TOKEN_TTL:-90d}" out tok
    command -v python3 >/dev/null 2>&1 || return 1
    out="$("${SERVER_DIR}/t3/t3" auth pairing create \
        --base-dir "${TRIM_PKGHOME}/.t3" \
        --ttl "$ttl" --label "fnos-desktop" --json 2>>"${LOG_FILE}")" || return 1
    tok="$(printf '%s' "$out" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    raise SystemExit
url = d.get("pairUrl") or ""
if "#token=" in url:
    print(url.rsplit("#token=", 1)[1]); raise SystemExit
for k in ("token", "pairingToken", "secret"):
    if d.get(k):
        print(d[k]); raise SystemExit
' 2>/dev/null)"
    [ -n "$tok" ] && printf '%s' "$tok"
}

set_url() {  # set_url <path[?query]> -> rewrite the desktop entry's url
    local cfg="${TRIM_APPDEST}/ui/config"
    sed -i "s|\"url\": \"[^\"]*\"|\"url\": \"$1\"|" "$cfg"
    # 桌面入口用的是独立端口（type: url），端口随 launcher_port 变化，必须同步写回
    sed -i "s|\"port\": \"[^\"]*\"|\"port\": \"${WEB_PORT}\"|" "$cfg" 2>/dev/null
}
